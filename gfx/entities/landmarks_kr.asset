entity = {
	name = "building_landmark_sadabad_complex"
	pdxmesh = "landmark_sadabad_complex_mesh"

	default_state = "idle"
	state = { name = "idle"				animation = "idle"       		animation_blend_time = 0.3 animation_speed = 1.0 looping = no }

	scale = 0.25

}

#DESTROYED
entity = {
	name = "building_landmark_sadabad_complex_destroyed"
	pdxmesh = "landmark_sadabad_complex_destroyed_mesh"

	default_state = "destroy"
	state = { name = "destroy"			animation = "destroy" 			animation_blend_time = 0.0  animation_speed = 0.9 looping = no
			event = { time = 0.1 node="explosion_roof" particle = "ship_explosion_particle" keep_particle = yes }
			event = { time = 0.3 node="explosion_ground" particle = "ship_damaged_smoke_particle" keep_particle = yes }
			event = { time = 2.2 node="roof_center_explosion" particle = "building_explode_effect" keep_particle = yes }
			event = { time = 2.6 node="fire_tower" particle = "vehicle_explode_effect" keep_particle = yes }
			event = { time = 3.5 node="fire_tower" particle = "building_fire_big_particle" keep_particle = yes }
			event = { time = 7.8 node="explosion_corner2" particle = "ship_explosion_particle" keep_particle = yes }
			event = { time = 8 node="explosion_corner1" particle = "building_explode_effect" keep_particle = yes }
			event = { time = 5.0 node="fire1" particle = "building_fire_particle" keep_particle = yes }
			event = { time = 13.8 node="explosion_ground1" particle = "ship_explosion_particle" keep_particle = yes }
			event = { time = 14 node="statue" particle = "building_explode_effect" keep_particle = yes }


			event = { time = 0.2 sound = { soundeffect = "explosion_c4" }}
			event = { time = 1.8 sound = { soundeffect = "explosion_flashbang_large" }}
			event = { time = 13 sound = { soundeffect = "explosion_c4" }}
			event = { time = 15 sound = { soundeffect = "explosion_flashbang_large" }}
			event = { time = 7 sound = { soundeffect = "building_large_crash_impact" }}


				}


	scale = 0.25

}

entity = {
	name = "building_landmark_forbidden_city"
	pdxmesh = "landmark_forbidden_city_mesh"

	default_state = "idle"
	state = { name = "idle"				animation = "idle"       		animation_blend_time = 0.3 animation_speed = 1.0 looping = no }

	scale = 0.1

}

#DESTROYED
entity = {
	name = "building_landmark_forbidden_city_destroyed"
	pdxmesh = "landmark_forbidden_city_destroyed_mesh"

	default_state = "destroy"
	state = { name = "destroy"			animation = "destroy" 			animation_blend_time = 0.0  animation_speed = 0.8 looping = no
			event = { time = 6 node="roof_explosion1" particle = "ship_explosion_particle" keep_particle = yes }
			event = { time = 10.2 node="roof_explosion2" particle = "building_explode_effect" keep_particle = yes }

			event = { time = 8 node="fire2" particle = "ship_explosion_particle" keep_particle = yes }
			event = { time = 8.8 node="fire3" particle = "ship_explosion_particle" keep_particle = yes }

			event = { time = 8 node="fire0" particle = "building_fire_particle" keep_particle = yes }
			event = { time = 10.5 node="fire1" particle = "building_fire_particle" keep_particle = yes }
			event = { time = 9 node="fire2" particle = "building_fire_particle" keep_particle = yes }
			event = { time = 10 node="fire3" particle = "building_fire_particle" keep_particle = yes }


			event = { time = 6.2 sound = { soundeffect = "explosion_c4" }}
			event = { time = 10.4 sound = { soundeffect = "explosion_flashbang_large" }}
			event = { time = 8.2 sound = { soundeffect = "explosion_c4" }}
			event = { time = 9 sound = { soundeffect = "explosion_c4" }}


				}


	scale = 0.1

}

entity = {
	name = "building_landmark_hofburg_palace"
	pdxmesh = "landmark_hofburg_palace_mesh"

	default_state = "idle"
	state = { name = "idle"				animation = "idle"       		animation_blend_time = 0.3 animation_speed = 1.0 looping = no }

	scale = 0.2

}





#DESTROYED
entity = {
	name = "building_landmark_hofburg_palace_destroyed"
	pdxmesh = "landmark_hofburg_palace_destroyed_mesh"

	default_state = "destroy"
	state = { name = "destroy"			animation = "destroy" 			animation_blend_time = 0.0  animation_speed = 1.0 looping = no next_state = "attack" chance = 1 
			event = { time = 0.2 node="explosion1" particle = "ship_explosion_particle" keep_particle = yes sound = { soundeffect = "explosion_element" }}
			event = { time = 4.1 node="explosion2" particle = "ship_explosion_particle" keep_particle = yes sound = { soundeffect = "explosion_small" }}
			event = { time = 15.8 node="explosion3" particle = "ship_explosion_particle" keep_particle = yes sound = { soundeffect = "explosion_big" }}
			event = { time = 13.5 node="explosion4" particle = "ship_explosion_particle" keep_particle = yes sound = { soundeffect = "explosion_big" }}
			event = { time = 21.1 node="explosion5" particle = "ship_explosion_particle" keep_particle = yes sound = { soundeffect = "explosion_big" }}
			event = { time = 1 node="explosion1" particle = "bunker_smoke_effect"  keep_particle = yes trigger_once = yes }
			event = { time = 1 node="explosion1" particle = "ship_damaged_smoke_particle"  keep_particle = yes trigger_once = yes sound = { soundeffect = "explosion_fuel_small" }}
			event = { time = 4.8 node="explosion2" particle = "ship_damaged_smoke_particle"  keep_particle = yes trigger_once = yes sound = { soundeffect = "explosion_fuel_small" }}
			event = { time = 16.8 node="explosion3" particle = "ship_damaged_smoke_particle"  keep_particle = yes trigger_once = yes sound = { soundeffect = "explosion_fuel_small" }}
			event = { time = 14.1 node="explosion4" particle = "ship_damaged_smoke_particle"  keep_particle = yes trigger_once = yes sound = { soundeffect = "explosion_fuel_small" }}
			event = { time = 25.1 node="fire_spread" particle = "ship_damaged_smoke_particle"  keep_particle = yes trigger_once = yes sound = { soundeffect = "explosion_fuel_small" }}
			event = { time = 1 node="explosion5" particle = "bunker_smoke_effect"  keep_particle = yes trigger_once = yes }
			event = { time = 2 node="impact1" particle = "ship_explosion_particle"  keep_particle = yes sound = { soundeffect = "explosion_large" }}	
			event = { time = 5 node="impact2" particle = "ship_explosion_particle"  keep_particle = yes sound = { soundeffect = "explosion_flashbang_large" }}	
			event = { time = 8.8 node="impact3" particle = "ship_explosion_particle"  keep_particle = yes sound = { soundeffect = "explosion_large" }}	
			event = { time = 0.3 sound = { soundeffect = "sub_hit" }}
	}


	scale = 0.2

}

